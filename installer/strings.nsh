; Installer texts beyond NSIS's own translations. $OldVersion is filled in
; at run time, ${VERSION} at build time. Same languages as the app.

LangString UpdateTitle ${LANG_ENGLISH} "Update ytmini"
LangString UpdateText ${LANG_ENGLISH} "ytmini $OldVersion is installed. Setup will update it to ${VERSION}.$\r$\n$\r$\nYour settings and sign-in are kept.$\r$\n$\r$\nClick Update to continue."
LangString UpdateButton ${LANG_ENGLISH} "&Update"
LangString DesktopShortcut ${LANG_ENGLISH} "Create a desktop shortcut"
LangString AppRunning ${LANG_ENGLISH} "ytmini is running. Close it and continue?"
LangString StillRunning ${LANG_ENGLISH} "ytmini couldn't be closed. Close it yourself, then click Retry."
LangString RemoveData ${LANG_ENGLISH} "Also delete your ytmini data (sign-in, settings, saved playback positions)?"

LangString UpdateTitle ${LANG_GERMAN} "ytmini aktualisieren"
LangString UpdateText ${LANG_GERMAN} "ytmini $OldVersion ist installiert. Setup aktualisiert auf ${VERSION}.$\r$\n$\r$\nDeine Einstellungen und Anmeldung bleiben erhalten.$\r$\n$\r$\nKlicke auf „Aktualisieren“, um fortzufahren."
LangString UpdateButton ${LANG_GERMAN} "&Aktualisieren"
LangString DesktopShortcut ${LANG_GERMAN} "Verknüpfung auf dem Desktop erstellen"
LangString AppRunning ${LANG_GERMAN} "ytmini läuft gerade. Schließen und fortfahren?"
LangString StillRunning ${LANG_GERMAN} "ytmini ließ sich nicht schließen. Schließe es selbst und klicke dann auf „Wiederholen“."
LangString RemoveData ${LANG_GERMAN} "Auch deine ytmini-Daten löschen (Anmeldung, Einstellungen, gemerkte Wiedergabepositionen)?"

LangString UpdateTitle ${LANG_SPANISH} "Actualizar ytmini"
LangString UpdateText ${LANG_SPANISH} "ytmini $OldVersion está instalado. El instalador lo actualizará a ${VERSION}.$\r$\n$\r$\nTus ajustes y tu sesión se conservan.$\r$\n$\r$\nHaz clic en Actualizar para continuar."
LangString UpdateButton ${LANG_SPANISH} "&Actualizar"
LangString DesktopShortcut ${LANG_SPANISH} "Crear un acceso directo en el escritorio"
LangString AppRunning ${LANG_SPANISH} "ytmini está abierto. ¿Cerrarlo y continuar?"
LangString StillRunning ${LANG_SPANISH} "No se pudo cerrar ytmini. Ciérralo tú y haz clic en Reintentar."
LangString RemoveData ${LANG_SPANISH} "¿Borrar también tus datos de ytmini (sesión, ajustes, posiciones de reproducción guardadas)?"

LangString UpdateTitle ${LANG_FRENCH} "Mettre à jour ytmini"
LangString UpdateText ${LANG_FRENCH} "ytmini $OldVersion est installé. Le programme d'installation va le mettre à jour vers ${VERSION}.$\r$\n$\r$\nVos réglages et votre connexion sont conservés.$\r$\n$\r$\nCliquez sur Mettre à jour pour continuer."
LangString UpdateButton ${LANG_FRENCH} "&Mettre à jour"
LangString DesktopShortcut ${LANG_FRENCH} "Créer un raccourci sur le bureau"
LangString AppRunning ${LANG_FRENCH} "ytmini est ouvert. Le fermer et continuer ?"
LangString StillRunning ${LANG_FRENCH} "Impossible de fermer ytmini. Fermez-le vous-même, puis cliquez sur Réessayer."
LangString RemoveData ${LANG_FRENCH} "Supprimer aussi vos données ytmini (connexion, réglages, positions de lecture enregistrées) ?"

LangString UpdateTitle ${LANG_ITALIAN} "Aggiorna ytmini"
LangString UpdateText ${LANG_ITALIAN} "ytmini $OldVersion è installato. L'installazione lo aggiornerà alla versione ${VERSION}.$\r$\n$\r$\nImpostazioni e accesso restano invariati.$\r$\n$\r$\nFai clic su Aggiorna per continuare."
LangString UpdateButton ${LANG_ITALIAN} "&Aggiorna"
LangString DesktopShortcut ${LANG_ITALIAN} "Crea un collegamento sul desktop"
LangString AppRunning ${LANG_ITALIAN} "ytmini è aperto. Chiuderlo e continuare?"
LangString StillRunning ${LANG_ITALIAN} "Impossibile chiudere ytmini. Chiudilo tu, poi fai clic su Riprova."
LangString RemoveData ${LANG_ITALIAN} "Eliminare anche i tuoi dati di ytmini (accesso, impostazioni, posizioni di riproduzione salvate)?"

LangString UpdateTitle ${LANG_JAPANESE} "ytmini を更新"
LangString UpdateText ${LANG_JAPANESE} "ytmini $OldVersion がインストールされています。${VERSION} に更新します。$\r$\n$\r$\n設定とログイン状態はそのまま残ります。$\r$\n$\r$\n続けるには［更新］をクリックしてください。"
LangString UpdateButton ${LANG_JAPANESE} "更新(&U)"
LangString DesktopShortcut ${LANG_JAPANESE} "デスクトップにショートカットを作成"
LangString AppRunning ${LANG_JAPANESE} "ytmini が実行中です。終了して続けますか？"
LangString StillRunning ${LANG_JAPANESE} "ytmini を終了できませんでした。手動で終了してから［再試行］をクリックしてください。"
LangString RemoveData ${LANG_JAPANESE} "ytmini のデータ（ログイン、設定、保存された再生位置）も削除しますか？"

LangString UpdateTitle ${LANG_KOREAN} "ytmini 업데이트"
LangString UpdateText ${LANG_KOREAN} "ytmini $OldVersion 버전이 설치되어 있습니다. ${VERSION} 버전으로 업데이트합니다.$\r$\n$\r$\n설정과 로그인 정보는 그대로 유지됩니다.$\r$\n$\r$\n계속하려면 업데이트를 클릭하세요."
LangString UpdateButton ${LANG_KOREAN} "업데이트(&U)"
LangString DesktopShortcut ${LANG_KOREAN} "바탕 화면에 바로 가기 만들기"
LangString AppRunning ${LANG_KOREAN} "ytmini가 실행 중입니다. 종료하고 계속할까요?"
LangString StillRunning ${LANG_KOREAN} "ytmini를 종료하지 못했습니다. 직접 종료한 후 다시 시도를 클릭하세요."
LangString RemoveData ${LANG_KOREAN} "ytmini 데이터(로그인, 설정, 저장된 재생 위치)도 삭제할까요?"

LangString UpdateTitle ${LANG_POLISH} "Aktualizacja ytmini"
LangString UpdateText ${LANG_POLISH} "Zainstalowano ytmini $OldVersion. Instalator zaktualizuje go do wersji ${VERSION}.$\r$\n$\r$\nUstawienia i logowanie zostaną zachowane.$\r$\n$\r$\nKliknij Aktualizuj, aby kontynuować."
LangString UpdateButton ${LANG_POLISH} "&Aktualizuj"
LangString DesktopShortcut ${LANG_POLISH} "Utwórz skrót na pulpicie"
LangString AppRunning ${LANG_POLISH} "ytmini jest uruchomiony. Zamknąć go i kontynuować?"
LangString StillRunning ${LANG_POLISH} "Nie udało się zamknąć ytmini. Zamknij go samodzielnie, a potem kliknij Ponów."
LangString RemoveData ${LANG_POLISH} "Usunąć też dane ytmini (logowanie, ustawienia, zapamiętane pozycje odtwarzania)?"

LangString UpdateTitle ${LANG_PORTUGUESEBR} "Atualizar o ytmini"
LangString UpdateText ${LANG_PORTUGUESEBR} "O ytmini $OldVersion está instalado. O instalador vai atualizá-lo para a versão ${VERSION}.$\r$\n$\r$\nSeus ajustes e sua sessão são mantidos.$\r$\n$\r$\nClique em Atualizar para continuar."
LangString UpdateButton ${LANG_PORTUGUESEBR} "&Atualizar"
LangString DesktopShortcut ${LANG_PORTUGUESEBR} "Criar um atalho na área de trabalho"
LangString AppRunning ${LANG_PORTUGUESEBR} "O ytmini está aberto. Fechar e continuar?"
LangString StillRunning ${LANG_PORTUGUESEBR} "Não foi possível fechar o ytmini. Feche-o você mesmo e clique em Repetir."
LangString RemoveData ${LANG_PORTUGUESEBR} "Apagar também seus dados do ytmini (sessão, ajustes, posições de reprodução salvas)?"

LangString UpdateTitle ${LANG_RUSSIAN} "Обновление ytmini"
LangString UpdateText ${LANG_RUSSIAN} "Установлена версия ytmini $OldVersion. Программа установки обновит её до ${VERSION}.$\r$\n$\r$\nНастройки и вход в аккаунт сохранятся.$\r$\n$\r$\nНажмите «Обновить», чтобы продолжить."
LangString UpdateButton ${LANG_RUSSIAN} "&Обновить"
LangString DesktopShortcut ${LANG_RUSSIAN} "Создать ярлык на рабочем столе"
LangString AppRunning ${LANG_RUSSIAN} "ytmini запущен. Закрыть его и продолжить?"
LangString StillRunning ${LANG_RUSSIAN} "Не удалось закрыть ytmini. Закройте его вручную и нажмите «Повтор»."
LangString RemoveData ${LANG_RUSSIAN} "Удалить также данные ytmini (вход, настройки, сохранённые позиции просмотра)?"

LangString UpdateTitle ${LANG_TURKISH} "ytmini'yi güncelle"
LangString UpdateText ${LANG_TURKISH} "ytmini $OldVersion yüklü. Kurulum onu ${VERSION} sürümüne güncelleyecek.$\r$\n$\r$\nAyarlarınız ve oturumunuz korunur.$\r$\n$\r$\nDevam etmek için Güncelle'ye tıklayın."
LangString UpdateButton ${LANG_TURKISH} "&Güncelle"
LangString DesktopShortcut ${LANG_TURKISH} "Masaüstüne kısayol oluştur"
LangString AppRunning ${LANG_TURKISH} "ytmini çalışıyor. Kapatılıp devam edilsin mi?"
LangString StillRunning ${LANG_TURKISH} "ytmini kapatılamadı. Kendiniz kapatın, ardından Yeniden Dene'ye tıklayın."
LangString RemoveData ${LANG_TURKISH} "ytmini verileriniz de silinsin mi (oturum, ayarlar, kaydedilmiş oynatma konumları)?"

LangString UpdateTitle ${LANG_UKRAINIAN} "Оновлення ytmini"
LangString UpdateText ${LANG_UKRAINIAN} "Встановлено ytmini $OldVersion. Програма встановлення оновить його до ${VERSION}.$\r$\n$\r$\nНалаштування та вхід в акаунт збережуться.$\r$\n$\r$\nНатисніть «Оновити», щоб продовжити."
LangString UpdateButton ${LANG_UKRAINIAN} "&Оновити"
LangString DesktopShortcut ${LANG_UKRAINIAN} "Створити ярлик на робочому столі"
LangString AppRunning ${LANG_UKRAINIAN} "ytmini запущено. Закрити його й продовжити?"
LangString StillRunning ${LANG_UKRAINIAN} "Не вдалося закрити ytmini. Закрийте його вручну й натисніть «Повторити»."
LangString RemoveData ${LANG_UKRAINIAN} "Видалити також дані ytmini (вхід, налаштування, збережені позиції перегляду)?"

LangString UpdateTitle ${LANG_SIMPCHINESE} "更新 ytmini"
LangString UpdateText ${LANG_SIMPCHINESE} "已安装 ytmini $OldVersion。安装程序将把它更新到 ${VERSION}。$\r$\n$\r$\n你的设置和登录状态会保留。$\r$\n$\r$\n点击“更新”继续。"
LangString UpdateButton ${LANG_SIMPCHINESE} "更新(&U)"
LangString DesktopShortcut ${LANG_SIMPCHINESE} "创建桌面快捷方式"
LangString AppRunning ${LANG_SIMPCHINESE} "ytmini 正在运行。要关闭它并继续吗？"
LangString StillRunning ${LANG_SIMPCHINESE} "无法关闭 ytmini。请手动关闭后点击“重试”。"
LangString RemoveData ${LANG_SIMPCHINESE} "同时删除你的 ytmini 数据（登录、设置、保存的播放位置）吗？"
